{
  "name": "forex-operator-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
