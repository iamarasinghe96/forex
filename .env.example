# Copy this file to .env on the Windows VPS. Never paste its contents into chat.
FOREX_MT5_PASSWORD=replace_with_demo_trading_password
# Optional for Layer 1. Both values are required before Telegram alerts are enabled.
FOREX_TELEGRAM_BOT_TOKEN=
FOREX_TELEGRAM_CHAT_ID=

# Optional Layer 6 provider secrets: populate only locally when enabling context.
FOREX_GROQ_API_KEY=
FOREX_GEMINI_API_KEY=
FOREX_OPENROUTER_API_KEY=

# Optional Firebase Admin credential path, VPS only; file itself must remain ignored.
FOREX_FIREBASE_SERVICE_ACCOUNT_FILE=
